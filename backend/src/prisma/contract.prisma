// use prisma-8
model KnowledgeBase {
  id       ObjectId @id @map("_id")
  code     String
  title    String
  category String
  content  String
  source   String

  @@unique([code])
  @@map("knowledge_base")
}

model EmployeeRequest {
  id          ObjectId @id @map("_id")
  code        String
  employee    String
  requestDate String
  request     String
  status      String
  details     String?

  @@unique([code])
  @@map("employee_requests")
}

model Ticket {
  id       ObjectId @id @map("_id")
  code     String
  employee String
  issue    String
  status   String
  details  String?

  @@unique([code])
  @@map("tickets")
}
